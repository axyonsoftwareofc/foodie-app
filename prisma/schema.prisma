generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PREPARING
  READY
  DELIVERING
  DELIVERED
  CANCELLED
}

enum OrderType {
  DINE_IN
  DELIVERY
  PICKUP
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  GERENCIADOR
  EQUIPE
  CLIENTE
}

enum RestaurantMemberRole {
  OWNER
  MANAGER
  KITCHEN
  WAITER
  DRIVER
}

enum RestaurantMemberStatus {
  INVITED
  ACTIVE
  DISABLED
}

enum RestaurantInvitationStatus {
  PENDING
  ACCEPTED
  CANCELLED
  EXPIRED
}

enum TableStatus {
  AVAILABLE
  OCCUPIED
  RESERVED
}

enum DeliveryStatus {
  PENDING
  ASSIGNED
  PICKED_UP
  DELIVERING
  DELIVERED
}

enum VehicleType {
  MOTO
  BIKE
  CAR
}

enum DeliveryZoneType {
  RADIUS
  POLYGON
  AREAS
}

enum RestaurantStatus {
  OPEN
  CLOSED
  BUSY
}

// ============================================================================
// AUTH & PROFILES
// ============================================================================

model Profile {
  id         String   @id @default(uuid())
  email      String   @unique
  full_name  String?
  phone      String?
  avatar_url String?
  role       UserRole @default(CLIENTE)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@map("profiles")
}

// ============================================================================
// RESTAURANTS
// ============================================================================

model Restaurant {
  id          String  @id @default(cuid())
  user_id     String
  name        String
  slug        String  @unique
  subdomain   String? @unique // Mantendo compatibilidade
  description String?
  logo        String?
  cover_image String?
  category    String?
  cuisine     String?
  phone       String?
  email       String?

  // Documento
  cnpj String?

  // Endereço
  street       String?
  number       String?
  complement   String?
  neighborhood String?
  city         String?
  state        String?
  zip_code     String?
  latitude     Float?
  longitude    Float?

  // Configurações de delivery
  delivery_fee            Float?
  minimum_order           Float?
  estimated_delivery_time Int?
  delivery_radius         Float?

  // Status
  status    RestaurantStatus @default(CLOSED)
  is_active Boolean          @default(true)

  // Horários
  operating_hours Json?

  // Controle operacional
  accepting_orders Boolean @default(true)

  // Informações bancárias
  bank_info Json?

  // Personalizacao
  theme Json?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  // Ratings desnormalizados (atualizados via action de review)
  avg_rating   Float   @default(0)
  review_count Int     @default(0)

  categories   Category[]
  products   Product[]
  orders     Order[]
  reviews    Review[]
  tables     RestaurantTable[]
  members    RestaurantMember[]
  invitations RestaurantInvitation[]
  auditLogs  AuditLog[]
  drivers    DeliveryDriver[]
  zones      DeliveryZone[]
  deliveries Delivery[]

  @@map("restaurants")
}

model RestaurantTable {
  id            String   @id @default(uuid())
  restaurant_id String
  number        String
  capacity      Int
  status        TableStatus   @default(AVAILABLE)
  qr_code       String?
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  restaurant Restaurant @relation(fields: [restaurant_id], references: [id], onDelete: Cascade)
  orders    Order[]

  @@map("restaurant_tables")
}

// ============================================================================
// MENU
// ============================================================================

model Category {
  id            String   @id @default(cuid())
  restaurant_id String
  name          String
  description   String?
  icon          String?
  image         String?
  sort_order    Int      @default(0)
  is_active     Boolean  @default(true)
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  restaurant Restaurant @relation(fields: [restaurant_id], references: [id], onDelete: Cascade)
  products   Product[]

  @@index([restaurant_id])
  @@map("categories")
}

model Product {
  id            String  @id @default(cuid())
  restaurant_id String
  category_id   String
  name          String
  description   String?
  price         Float
  image         String?
  is_available  Boolean @default(true)
  is_active     Boolean @default(true)

  // Features extras
  badges           String[] @default([])
  options          Json?
  preparation_time Int?
  calories         Int?

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  category   Category   @relation(fields: [category_id], references: [id], onDelete: Cascade)
  restaurant Restaurant @relation(fields: [restaurant_id], references: [id], onDelete: Cascade)

  @@index([restaurant_id])
  @@index([category_id])
  @@map("products")
}

// ============================================================================
// ORDERS
// ============================================================================

model Order {
  id               String      @id @default(uuid())
  customer_id      String?
  customer_name    String
  customer_phone   String?
  order_type       OrderType    @default(DINE_IN)
  table_number     String?
  table_id         String?
  created_by_user_id   String?
  created_by_member_id String?
  delivery_address String?
  status           OrderStatus @default(PENDING)
  items            Json
  kitchen_notes    Json?
  total            Float
  created_at       DateTime    @default(now())
  updated_at       DateTime    @updatedAt
  restaurant_id    String

  // Pagamento
  payment_method    String?
  payment_provider  String? // STRIPE, MERCADOPAGO, PIX, PAYPAL
  payment_intent_id String?
  payment_status    String? // succeeded, failed, pending, cancelled
  change_for        Float?
  subtotal          Float?
  delivery_fee      Float?
  discount          Float?
  coupon_code       String?

  // Cancelamento
  cancelled_at  DateTime?
  cancel_reason String?

  // Prazos de preparo
  confirmed_at               DateTime?
  estimated_preparation_time Int?
  estimated_delivery         String?
  preparation_started_at     DateTime?
  ready_at                   DateTime?
  delivering_at              DateTime?
  delivered_at               DateTime?

  restaurant Restaurant      @relation(fields: [restaurant_id], references: [id], onDelete: Cascade)
  table      RestaurantTable? @relation(fields: [table_id], references: [id], onDelete: SetNull)
  created_by_member RestaurantMember? @relation(fields: [created_by_member_id], references: [id], onDelete: SetNull)
  delivery   Delivery?
  reviews    Review[]

  @@index([restaurant_id])
  @@index([status])
  @@index([created_at])
  @@index([customer_id])
  @@index([table_id])
  @@index([created_by_user_id])
  @@index([created_by_member_id])
  @@index([restaurant_id, status])
  @@index([restaurant_id, created_at])
  @@map("orders")
}

// ============================================================================
// RESTAURANT TEAM, INVITATIONS & AUDIT
// ============================================================================

model RestaurantMember {
  id            String                 @id @default(cuid())
  restaurant_id String
  user_id       String?
  email         String
  full_name     String?
  phone         String?
  role          RestaurantMemberRole
  status        RestaurantMemberStatus @default(INVITED)
  invited_by    String?
  joined_at     DateTime?
  disabled_at   DateTime?
  created_at    DateTime               @default(now())
  updated_at    DateTime               @updatedAt

  restaurant Restaurant @relation(fields: [restaurant_id], references: [id], onDelete: Cascade)
  orders     Order[]

  @@unique([restaurant_id, email])
  @@unique([restaurant_id, user_id])
  @@index([restaurant_id])
  @@index([user_id])
  @@index([role])
  @@index([status])
  @@map("restaurant_members")
}

model RestaurantInvitation {
  id            String                     @id @default(cuid())
  restaurant_id String
  email         String
  full_name     String?
  phone         String?
  role          RestaurantMemberRole
  token_hash    String                     @unique
  status        RestaurantInvitationStatus @default(PENDING)
  invited_by    String
  accepted_by   String?
  expires_at    DateTime
  accepted_at   DateTime?
  cancelled_at  DateTime?
  created_at    DateTime                   @default(now())
  updated_at    DateTime                   @updatedAt

  restaurant Restaurant @relation(fields: [restaurant_id], references: [id], onDelete: Cascade)

  @@index([restaurant_id])
  @@index([email])
  @@index([status])
  @@index([expires_at])
  @@map("restaurant_invitations")
}

model AuditLog {
  id            String   @id @default(cuid())
  restaurant_id String
  actor_user_id String?
  actor_member_id String?
  action        String
  entity_type   String
  entity_id     String?
  metadata      Json?
  ip_address    String?
  user_agent    String?
  created_at    DateTime @default(now())

  restaurant Restaurant @relation(fields: [restaurant_id], references: [id], onDelete: Cascade)

  @@index([restaurant_id])
  @@index([actor_user_id])
  @@index([actor_member_id])
  @@index([action])
  @@index([entity_type, entity_id])
  @@index([created_at])
  @@map("audit_logs")
}

// ============================================================================
// USER PREFERENCES & PRIVACY
// ============================================================================

model UserPrivacySettings {
  id                  String   @id @default(uuid())
  user_id             String   @unique
  show_profile        Boolean  @default(true)
  show_order_history  Boolean  @default(true)
  allow_marketing     Boolean  @default(true)
  allow_notifications Boolean  @default(true)
  data_sharing        Boolean  @default(false)
  two_factor_enabled  Boolean  @default(false)
  created_at          DateTime @default(now())
  updated_at          DateTime @updatedAt

  @@map("user_privacy_settings")
}

model UserPreferences {
  id                         String   @id @default(uuid())
  user_id                    String   @unique
  dietary_restrictions       String[] @default([])
  favorite_cuisines          String[] @default([])
  notification_order_updates Boolean  @default(true)
  notification_promotions    Boolean  @default(true)
  notification_newsletter    Boolean  @default(true)
  created_at                 DateTime @default(now())
  updated_at                 DateTime @updatedAt

  @@map("user_preferences")
}

model UserFavorite {
  id            String   @id @default(uuid())
  user_id       String
  restaurant_id String
  created_at    DateTime @default(now())

  @@unique([user_id, restaurant_id])
  @@map("user_favorites")
}

model Address {
  id           String   @id @default(uuid())
  user_id      String
  label        String
  street       String
  number       String
  complement   String?
  neighborhood String
  city         String
  state        String
  zip_code     String
  is_default   Boolean  @default(false)
  instructions String?
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  @@map("addresses")
}

model Review {
  id            String    @id @default(uuid())
  restaurant_id String
  user_id       String
  order_id      String?
  rating        Int
  comment       String?
  response      String?
  responded_at  DateTime?
  created_at    DateTime  @default(now())

  order      Order?      @relation(fields: [order_id], references: [id], onDelete: SetNull)
  restaurant Restaurant? @relation(fields: [restaurant_id], references: [id], onDelete: Cascade)

  @@index([restaurant_id])
  @@index([order_id])
  @@index([user_id])
  @@map("reviews")
}

// ============================================================================
// DELIVERY
// ============================================================================

model DeliveryDriver {
  id             String       @id @default(cuid())
  user_id        String?      @unique
  restaurant_id  String
  name           String
  phone          String
  vehicle_type   VehicleType  @default(MOTO)
  vehicle_plate  String?
  photo_url      String?
  rating         Float        @default(5.0)
  total_deliveries Int         @default(0)
  is_available   Boolean      @default(true)
  is_active      Boolean      @default(true)
  created_at     DateTime     @default(now())
  updated_at     DateTime     @updatedAt

  restaurant Restaurant @relation(fields: [restaurant_id], references: [id], onDelete: Cascade)
  deliveries Delivery[]

  @@index([restaurant_id])
  @@index([user_id])
  @@map("delivery_drivers")
}

model DeliveryZone {
  id                    String           @id @default(cuid())
  restaurant_id         String
  name                 String
  type                 DeliveryZoneType @default(RADIUS)
  center_latitude      Float?
  center_longitude     Float?
  radius_km            Float?
  delivery_fee         Float
  fee_per_km           Float?
  min_order_value      Float            @default(0)
  estimated_time_minutes Int             @default(30)
  is_active            Boolean          @default(true)
  priority             Int              @default(0)
  created_at           DateTime         @default(now())
  updated_at           DateTime         @updatedAt

  restaurant Restaurant @relation(fields: [restaurant_id], references: [id], onDelete: Cascade)

  @@index([restaurant_id])
  @@map("delivery_zones")
}

model Delivery {
  id                  String         @id @default(cuid())
  order_id            String         @unique
  restaurant_id       String
  driver_id           String?
  status              DeliveryStatus @default(PENDING)
  pickup_address      String
  delivery_address    String
  pickup_latitude     Float?
  pickup_longitude    Float?
  delivery_latitude   Float?
  delivery_longitude  Float?
  current_latitude    Float?
  current_longitude   Float?
  distance_km         Float?
  delivery_fee        Float          @default(0)
  estimated_pickup_time String?
  estimated_delivery_time String?
  actual_pickup_time    String?
  actual_delivery_time  String?
  proof_photo_url      String?
  proof_notes           String?
  proof_signed_by       String?
  proof_timestamp       String?
  timeline             Json?
  created_at           DateTime       @default(now())
  updated_at           DateTime       @updatedAt

  order       Order          @relation(fields: [order_id], references: [id], onDelete: Cascade)
  restaurant  Restaurant     @relation(fields: [restaurant_id], references: [id], onDelete: Cascade)
  driver      DeliveryDriver? @relation(fields: [driver_id], references: [id], onDelete: SetNull)

  @@index([restaurant_id])
  @@index([driver_id])
  @@index([status])
  @@map("deliveries")
}
