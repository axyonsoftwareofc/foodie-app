# ===========================================
# SUPABASE + DATABASE (OBRIGATÓRIO)
# ===========================================
# Obtenha as chaves em https://supabase.com/dashboard/project/_/settings/api
DATABASE_URL=postgresql://postgres:password@localhost:5432/foodie?pgbouncer=true
DIRECT_URL=postgresql://postgres:password@localhost:5432/foodie
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
# ATENCAO: a service_role ignora RLS (acesso administrativo total ao banco).
# Nunca commite esta chave — use apenas em .env.local e nos secrets do deploy.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Senha temporaria usada por `npm run seed:owners` nas contas de demonstracao (OPCIONAL)
SEED_OWNER_PASSWORD=defina_uma_senha_forte_aqui

# ===========================================
# SEGURANÇA (OBRIGATÓRIO)
# ===========================================
# Gere com: openssl rand -hex 32
COOKIE_SIGNING_SECRET=sua_chave_aleatoria_de_64_caracteres_aqui
NEXTAUTH_SECRET=sua_chave_aleatoria_de_64_caracteres_aqui

# ===========================================
# APP URL (OBRIGATÓRIO)
# ===========================================
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_DOMAIN=foodie.app

# ===========================================
# REDIS — Upstash (Cache, Rate Limiting, Idempotência) (OPCIONAL)
# ===========================================
# Sem Redis, rate limiting e cache são desabilitados com graceful degradation
# Obtenha em https://console.upstash.com
REDIS_URL=https://your-redis-url.upstash.io
REDIS_TOKEN=your_redis_token

# ===========================================
# STRIPE — Cartões de Crédito/Débito (OPCIONAL — feature flag)
# ===========================================
# Obtenha as chaves em https://dashboard.stripe.com/apikeys
ENABLE_STRIPE_PAYMENTS=false
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key
STRIPE_SECRET_KEY=sk_test_your_secret_key
STRIPE_API_VERSION=2024-12-18.acacia
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret

# ===========================================
# MERCADO PAGO — Cartões, Pix, Boleto (OPCIONAL — feature flag)
# ===========================================
# Obtenha as chaves em https://dashboard.mercadopago.com.br/applications
ENABLE_MERCADOPAGO_PAYMENTS=false
MERCADOPAGO_ACCESS_TOKEN=your_access_token
MERCADOPAGO_PUBLIC_KEY=your_public_key
MERCADOPAGO_WEBHOOK_SECRET=your_webhook_secret

# ===========================================
# PAYPAL (OPCIONAL)
# ===========================================
# Obtenha as chaves em https://developer.paypal.com
PAYPAL_CLIENT_ID=your_client_id
PAYPAL_CLIENT_SECRET=your_client_secret
PAYPAL_MODE=sandbox  # sandbox ou live

# ===========================================
# PAGSEGURO — Cartões, Pix, Boleto (OPCIONAL)
# ===========================================
# Obtenha as chaves em https://pagseguro.uol.com.br
PAGSEGURO_EMAIL=your_email
PAGSEGURO_TOKEN=your_token
PAGSEGURO_MODE=sandbox

# ===========================================
# PIX — Configurações Manuais (OPCIONAL)
# ===========================================
PIX_KEY=seu@email.com
PIX_KEY_TYPE=email  # email, cpf, cnpj, telefone, aleatoria

# ===========================================
# EMAIL — SMTP (OPCIONAL)
# ===========================================
# Gere uma senha de app em: https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seuemail@gmail.com
SMTP_PASS=sua_senha_de_app
SMTP_FROM=seuemail@gmail.com

# ===========================================
# CLOUDINARY — Upload de Imagens (OPCIONAL)
# ===========================================
# Obtenha em https://console.cloudinary.com
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# ===========================================
# SENTRY — Error Tracking (OPCIONAL)
# ===========================================
# Obtenha em https://sentry.io
NEXT_PUBLIC_SENTRY_DSN=https://your-public-dsn@o000000.ingest.sentry.io/0000000
SENTRY_ENVIRONMENT=development
SENTRY_AUTH_TOKEN=sntrys_your_auth_token_here
SENTRY_ORG=your-sentry-org
SENTRY_PROJECT=your-sentry-project

# ===========================================
# HEALTH CHECK (OPCIONAL)
# ===========================================
# Se definido, o endpoint /api/health exige Authorization: Bearer <token>
HEALTH_API_TOKEN=seu_token_de_health_check
